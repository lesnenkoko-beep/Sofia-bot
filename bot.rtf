def daily_check():\
    while True:\
        try:\
            now = datetime.datetime.now()\
            if now.hour == 10:\
                conn_t = sqlite3.connect('clients.db', check_same_thread=False)\
                cursor_t = conn_t.cursor()\
                cursor_t.execute("SELECT name, tg_id, expiry_date FROM clients WHERE balance > 0")\
\
                for row in cursor_t.fetchall():\
                    name, tg_id, expiry_date = row\
                    try:\
                        exp_d = datetime.datetime.strptime(expiry_date, '%d.%m.%Y').date()\
                        tomorrow = datetime.date.today() + datetime.timedelta(days=1)\
\
                        if exp_d == tomorrow:\
                            if tg_id:\
                                bot.send_message(tg_id, f"\uc0\u9888 \u65039  <b>\u1053 \u1072 \u1075 \u1072 \u1076 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 :</b> \u1090 \u1074 \u1110 \u1081  \u1072 \u1073 \u1086 \u1085 \u1077 \u1084 \u1077 \u1085 \u1090  \u1079 \u1072 \u1082 \u1110 \u1085 \u1095 \u1091 \u1108 \u1090 \u1100 \u1089 \u1103  \u1074 \u1078 \u1077  \u1079 \u1072 \u1074 \u1090 \u1088 \u1072  (\{expiry_date\})!", parse_mode='HTML')\
                            for coach in COACH_TELEGRAM_IDS:\
                                bot.send_message(coach, f"\uc0\u55357 \u56596  <b>\u1059 \u1074 \u1072 \u1075 \u1072 :</b> \u1059  \u1082 \u1083 \u1110 \u1108 \u1085 \u1090 \u1082 \u1080  <b>\{name\}</b> \u1072 \u1073 \u1086 \u1085 \u1077 \u1084 \u1077 \u1085 \u1090  \u1079 \u1072 \u1082 \u1110 \u1085 \u1095 \u1091 \u1108 \u1090 \u1100 \u1089 \u1103  \u1079 \u1072 \u1074 \u1090 \u1088 \u1072  (\{expiry_date\})!", parse_mode='HTML')\
                    except Exception:\
                        pass\
                conn_t.close()\
                time.sleep(7200)\
            else:\
                time.sleep(1800)\
        except Exception:\
            time.sleep(1800)\
\
