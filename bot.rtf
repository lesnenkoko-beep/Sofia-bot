def process_add_client(message):\
    try:\
        parts = message.text.split()\
        if len(parts) < 2:\
            raise ValueError\
\
        last_part = parts[-1]\
        try:\
            valid_date = datetime.datetime.strptime(last_part, '%d.%m.%Y').date()\
            expiry = valid_date.strftime('%d.%m.%Y')\
            balance = int(parts[-2])\
            name = " ".join(parts[:-2]).strip()\
        except ValueError:\
            balance = int(parts[-1])\
            name = " ".join(parts[:-1]).strip()\
            expiry = (datetime.date.today() + datetime.timedelta(days=30)).strftime('%d.%m.%Y')\
\
        cursor.execute(\
            "INSERT INTO clients (name, balance, attended, expiry_date) VALUES (?, ?, 0, ?)",\
            (name, balance, expiry)\
        )\
        conn.commit()\
\
        client_id = cursor.lastrowid\
        bot_username = bot.get_me().username\
        invite_link = "https://t.me/" + str(bot_username) + "?start=" + str(client_id)\
\
        text_reply = (\
            f"\uc0\u9989  \u1050 \u1083 \u1110 \u1108 \u1085 \u1090 \u1082 \u1091  <b>\{name\}</b> \u1076 \u1086 \u1076 \u1072 \u1085 \u1086 !\\n"\
            f"\uc0\u1040 \u1073 \u1086 \u1085 \u1077 \u1084 \u1077 \u1085 \u1090  \u1085 \u1072  \{balance\} \u1079 \u1072 \u1085 \u1103 \u1090 \u1100 , \u1076 \u1110 \u1108  \u1076 \u1086  \{expiry\}.\\n\\n"\
            f"\uc0\u55357 \u56599  <b>\u1055 \u1086 \u1089 \u1080 \u1083 \u1072 \u1085 \u1085 \u1103  \u1076 \u1083 \u1103  \u1085 \u1077 \u1111 :</b>\\n\{invite_link\}"\
        )\
        bot.send_message(message.chat.id, text_reply, parse_mode='HTML', disable_web_page_preview=True)\
    except Exception:\
        bot.send_message(message.chat.id, "\uc0\u10060  \u1055 \u1086 \u1084 \u1080 \u1083 \u1082 \u1072  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090 \u1091 . \u1057 \u1087 \u1088 \u1086 \u1073 \u1091 \u1081  \u1097 \u1077  \u1088 \u1072 \u1079  (\u1085 \u1072 \u1087 \u1088 \u1080 \u1082 \u1083 \u1072 \u1076 : \u1054 \u1083 \u1077 \u1085 \u1072  8).")\
